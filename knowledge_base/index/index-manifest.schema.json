{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "index_version", "collection_name", "distance", "vector_size", "embedding_provider", "embedding_model", "embedding_dimensions", "source_chunks_sha256", "source_manifest_sha256", "total_points", "payload_schema_version", "point_id_strategy", "chunk_ids_sha256", "indexed_documents"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "index_version": {"const": "1.0.0"},
    "collection_name": {"type": "string", "minLength": 1},
    "distance": {"const": "Cosine"},
    "vector_size": {"type": "integer", "minimum": 1},
    "embedding_provider": {"type": "string", "minLength": 1},
    "embedding_model": {"type": "string", "minLength": 1},
    "embedding_dimensions": {"type": "integer", "minimum": 1},
    "source_chunks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "total_points": {"type": "integer", "minimum": 1},
    "payload_schema_version": {"const": "1.0"},
    "point_id_strategy": {"const": "uuid5-nexodocs-chunk-id"},
    "chunk_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "indexed_documents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["document_id", "chunk_count", "source_sha256"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "chunk_count": {"type": "integer", "minimum": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
