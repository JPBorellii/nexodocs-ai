{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "plan_version", "collection_name", "distance", "vector_size", "embedding_provider", "embedding_model", "embedding_dimensions", "source_chunks_sha256", "source_manifest_sha256", "total_points", "chunk_ids_sha256", "payload_schema_version", "point_id_strategy", "documents", "points"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_version": {"const": "1.0.0"},
    "collection_name": {"type": "string", "minLength": 1},
    "distance": {"const": "Cosine"},
    "vector_size": {"type": "integer", "minimum": 1},
    "embedding_provider": {"const": "openai"},
    "embedding_model": {"type": "string", "minLength": 1},
    "embedding_dimensions": {"type": "integer", "minimum": 1},
    "source_chunks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "total_points": {"const": 44},
    "chunk_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_schema_version": {"const": "1.0"},
    "point_id_strategy": {"const": "uuid5-nexodocs-chunk-id"},
    "documents": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "required": ["document_id", "chunk_count", "source_sha256"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "chunk_count": {"type": "integer", "minimum": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }, "additionalProperties": false
      }
    },
    "points": {
      "type": "array", "minItems": 44, "maxItems": 44,
      "items": {
        "type": "object", "required": ["chunk_id", "point_id", "document_id", "text_sha256", "payload_sha256"],
        "properties": {
          "chunk_id": {"type": "string", "pattern": "^nsi-chk-[0-9a-f]{24}$"},
          "point_id": {"type": "string", "format": "uuid"},
          "document_id": {"type": "string", "minLength": 1},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
