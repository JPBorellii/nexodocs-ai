{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexoDocs AI sanitized retrieval holdout result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "evaluation_layer", "attempt_number", "threshold_policy_version", "threshold_policy_sha256", "threshold_frozen", "score_threshold", "top_k", "case_count", "supported_case_count", "unsupported_case_count", "supported_recall_at_5", "supported_hit_rate_at_5", "supported_top1_accuracy", "supported_mrr", "unsupported_fallback_accuracy", "status_accuracy", "logical_api_calls", "physical_attempts", "generation_api_calls", "prompt_tokens", "total_tokens", "failed_case_ids", "supported_quality_passed", "unsupported_fallback_passed", "holdout_supported_floor", "holdout_unsupported_ceiling", "holdout_scalar_separation_gap", "threshold_only_separation_possible", "threshold_changed", "retrieval_decision", "next_evaluation", "source_summary_sha256", "index_manifest_sha256", "chunks_sha256", "processed_manifest_sha256", "index_plan_sha256", "case_outcomes", "failed_cases"],
  "properties": {
    "schema_version": {"const": "1.0"}, "evaluation_id": {"const": "retrieval-holdout-r01"}, "evaluation_layer": {"const": "retrieval"}, "attempt_number": {"const": 1},
    "threshold_policy_version": {"const": "retrieval-threshold-v1"}, "threshold_policy_sha256": {"$ref": "#/$defs/sha256"}, "threshold_frozen": {"const": true}, "score_threshold": {"const": 0.46}, "top_k": {"const": 5},
    "case_count": {"const": 12}, "supported_case_count": {"const": 6}, "unsupported_case_count": {"const": 6}, "supported_recall_at_5": {"$ref": "#/$defs/rate"}, "supported_hit_rate_at_5": {"$ref": "#/$defs/rate"}, "supported_top1_accuracy": {"$ref": "#/$defs/rate"}, "supported_mrr": {"$ref": "#/$defs/rate"}, "unsupported_fallback_accuracy": {"$ref": "#/$defs/rate"}, "status_accuracy": {"$ref": "#/$defs/rate"},
    "logical_api_calls": {"type": "integer", "minimum": 0}, "physical_attempts": {"type": "integer", "minimum": 0}, "generation_api_calls": {"const": 0}, "prompt_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0},
    "failed_case_ids": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"const": "HOLD-N01"}, {"const": "HOLD-N02"}, {"const": "HOLD-N04"}], "items": false}, "supported_quality_passed": {"const": true}, "unsupported_fallback_passed": {"const": false},
    "holdout_supported_floor": {"$ref": "#/$defs/rate"}, "holdout_unsupported_ceiling": {"$ref": "#/$defs/rate"}, "holdout_scalar_separation_gap": {"type": "number", "minimum": -1, "maximum": 1}, "threshold_only_separation_possible": {"const": false}, "threshold_changed": {"const": false}, "retrieval_decision": {"const": "HOLDOUT_FAILED"}, "next_evaluation": {"const": "full_rag_holdout_r01"},
    "source_summary_sha256": {"$ref": "#/$defs/sha256"}, "index_manifest_sha256": {"$ref": "#/$defs/sha256"}, "chunks_sha256": {"$ref": "#/$defs/sha256"}, "processed_manifest_sha256": {"$ref": "#/$defs/sha256"}, "index_plan_sha256": {"$ref": "#/$defs/sha256"},
    "case_outcomes": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/case_outcome"}}, "failed_cases": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/failed_case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "case_outcome": {"type": "object", "additionalProperties": false, "required": ["case_id", "kind", "expected_status", "actual_status", "result_count", "expected_document_id", "expected_rank", "expected_document_score", "top_document_id", "top_score", "passed"], "properties": {"case_id": {"enum": ["HOLD-P01", "HOLD-P02", "HOLD-P03", "HOLD-P04", "HOLD-P05", "HOLD-P06", "HOLD-N01", "HOLD-N02", "HOLD-N03", "HOLD-N04", "HOLD-N05", "HOLD-N06"]}, "kind": {"enum": ["supported", "unsupported-near-domain", "unsupported-medical", "unsupported-business", "unsupported-operational", "unsupported-out-of-domain"]}, "expected_status": {"enum": ["found", "no_evidence"]}, "actual_status": {"enum": ["found", "no_evidence"]}, "result_count": {"type": "integer", "minimum": 0, "maximum": 5}, "expected_document_id": {"type": ["string", "null"], "pattern": "^NSI-[A-Z-]+-[0-9]{3}$"}, "expected_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}, "expected_document_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "top_document_id": {"type": ["string", "null"], "pattern": "^NSI-[A-Z-]+-[0-9]{3}$"}, "top_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "passed": {"type": "boolean"}}},
    "failed_case": {"type": "object", "additionalProperties": false, "required": ["case_id", "kind", "actual_status", "result_count", "top_document_id", "top_score", "failure_reason_code"], "properties": {"case_id": {"enum": ["HOLD-N01", "HOLD-N02", "HOLD-N04"]}, "kind": {"enum": ["unsupported-near-domain", "unsupported-business"]}, "actual_status": {"const": "found"}, "result_count": {"type": "integer", "minimum": 1, "maximum": 5}, "top_document_id": {"type": "string", "pattern": "^NSI-[A-Z-]+-[0-9]{3}$"}, "top_score": {"$ref": "#/$defs/rate"}, "failure_reason_code": {"enum": ["near_domain_false_positive", "entity_overlap_false_positive", "organization_context_false_positive"]}}}
  }
}
