          "properties": {
            "answer_provider": {"const": "openai"}, "answer_model": {"const": "gpt-5.6-luna"}, "answer_timeout_seconds": {"const": 45}, "answer_transport_max_retries": {"const": 0}, "answer_max_output_tokens": {"const": 1200}, "max_generation_attempts": {"const": 2}, "prompt_version": {"const": "rag-v1"}, "rendering_strategy_version": {"const": "json-data-v1"}, "system_prompt_sha256": {"const": "ea384d6a18cebc0f315a1150238f1df38e9ade4bd7fef237fb267c7d136cd674"}, "answer_prompt_sha256": {"const": "f823cc9cc49423dfa5b56174196e19f876b99f2b8696ae266c74736fcf4cc0d0"}, "max_query_characters": {"const": 2000}, "max_context_characters": {"const": 12000}, "min_context_characters": {"const": 80}, "max_context_chunks": {"const": 8}, "max_answer_characters": {"const": 4000}, "max_supporting_excerpt_characters": {"const": 500}, "min_evidence_results": {"const": 1}
          }
        }
