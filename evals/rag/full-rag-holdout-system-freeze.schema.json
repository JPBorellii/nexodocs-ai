{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexoDocs AI full RAG holdout system freeze",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "frozen_files"],
  "properties": {
    "schema_version": {"const": "1.0"}, "evaluation_id": {"const": "full-rag-holdout-r01"},
    "frozen_files": {"type": "array", "minItems": 16, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["component", "path", "sha256"], "properties": {"component": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
  }
}
