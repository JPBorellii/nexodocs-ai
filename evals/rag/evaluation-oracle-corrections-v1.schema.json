{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexoDocs AI evaluation oracle corrections v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "subject_evaluation_id", "corrections"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"const": "evaluation-oracle-corrections-v1"},
    "subject_evaluation_id": {"const": "full-rag-holdout-r02"},
    "corrections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/correction"}
    }
  },
  "$defs": {
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "original_fact_code",
        "correction_type",
        "source_document_id",
        "evidence_scope",
        "corrected_expectation_code",
        "sanitized_findings",
        "future_fixture_directive"
      ],
      "properties": {
        "case_id": {"const": "HOLD-P05"},
        "original_fact_code": {"const": "nexo_integral_active_north_unit"},
        "correction_type": {"const": "EVALUATION_ORACLE_DEFECT"},
        "source_document_id": {"const": "NSI-TAB-COV-001"},
        "evidence_scope": {"const": "R02_RETRIEVED_EVIDENCE"},
        "corrected_expectation_code": {
          "const": "nexo_integral_not_confirmed_for_north_unit"
        },
        "sanitized_findings": {
          "const": [
            "NORTH_UNIT_ACTIVE_NOT_EVIDENCED",
            "NEXO_INTEGRAL_ASSOCIATED_WITH_CENTER_UNIT",
            "NEXO_INTEGRAL_OBSERVED_STATUS_RESTRICTED"
          ]
        },
        "future_fixture_directive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture_id", "preserve_question", "use_corrected_expectation"],
          "properties": {
            "fixture_id": {"const": "full-rag-holdout-r03"},
            "preserve_question": {"const": true},
            "use_corrected_expectation": {"const": true}
          }
        }
      }
    }
  }
}
